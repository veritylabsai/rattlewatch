# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Rattlewatch runtime data (generated by `python -m rattlewatch build`)
var/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# openFDA fetch cache: large machine-generated snapshots, not curated fixtures.
# (tests/fixtures/recalls.json IS curated and committed deliberately.)
tests/fixtures/fda_*.json

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Secrets — never commit keys, tokens, or payment credentials
.env
*.pem
*credentials*.json
